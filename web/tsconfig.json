{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "lib/*": ["lib/*"],
            "components/*": ["components/*"],
            "front_end/*": ["front_end/*"],
            "generated/*": ["generated/*"]
        }
    },
    "include": ["front_end", "components", "lib", "generated"]
}
